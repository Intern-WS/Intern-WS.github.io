---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
---

<DefaultLayout title="404">
  <!-- Error heading clearly identifies that the requested page was not found. -->
  <section class="my-12">
    <div class="container">
      <Heading level="h1">404</Heading>
    </div>
  </section>
  <section class="my-12">
    <div class="space-content container">
      <p class="text-2xl">We could not find that page. You can return home or contact the firm for help.</p>
      <!-- Familiar wording and a home icon make the recovery action predictable. -->
      <Link href="/" isButton type="primary">
        Return to the homepage
        <Icon aria-hidden="true" name="lucide:home" size="1.5rem" />
      </Link>
    </div>
  </section>
</DefaultLayout>
