---
import { Link } from 'accessible-astro-components'
import themeConfig from '@theme-config'

---

<Link href="/" class="brand-lockup flex items-center gap-3">
  <!-- Text remains readable without an image and clearly ties the microsite to the firm. -->
  <span class="brand-mark" aria-hidden="true">W&amp;S</span>
  <span>
    <span class="brand-name">{themeConfig.name}</span>
    <span class="brand-owner">A website of Williams &amp; Swee, Ltd.</span>
  </span>
</Link>

<style>
  .brand-lockup { text-decoration: none !important; }
  .brand-mark { display:grid; place-items:center; width:3.25rem; height:3.25rem; border:2px solid #b9862f; border-radius:50%; color:#173f63; font-family:Georgia,serif; font-weight:700; }
  .brand-name,.brand-owner { display:block; }
  .brand-name { color:#173f63; font-size:clamp(1rem,2vw,1.25rem); font-weight:800; line-height:1.15; }
  .brand-owner { color:#44515b; font-size:.78rem; line-height:1.25; margin-top:.2rem; }
  @media (max-width: 430px) { .brand-owner { max-width:12rem; } }
</style>
